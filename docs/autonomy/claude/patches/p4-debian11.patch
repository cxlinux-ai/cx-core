diff --git a/.github/workflows/gen_debian11.yml b/.github/workflows/gen_debian11.yml
index 584c0e3..c939b26 100644
--- a/.github/workflows/gen_debian11.yml
+++ b/.github/workflows/gen_debian11.yml
@@ -40,6 +40,9 @@ jobs:
       - name: "set APT to non-interactive"
         shell: bash
         run: "echo 'debconf debconf/frontend select Noninteractive' | debconf-set-selections"
+      - name: "Use archive.debian.org for EOL Debian 11 security updates"
+        shell: bash
+        run: "{ grep -rl 'deb.debian.org/debian-security' /etc/apt/sources.list /etc/apt/sources.list.d 2>/dev/null || true; } | xargs -r sed -i 's|deb.debian.org/debian-security|archive.debian.org/debian-security|g'"
       - name: "Update APT"
         shell: bash
         run: "apt update"
