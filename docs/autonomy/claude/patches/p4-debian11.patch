diff --git a/ci/generate-workflows.py b/ci/generate-workflows.py
index e7c72d1..1ffd728 100755
--- a/ci/generate-workflows.py
+++ b/ci/generate-workflows.py
@@ -836,6 +836,17 @@ rustup default {toolchain}
                         "echo 'debconf debconf/frontend select Noninteractive' | debconf-set-selections",
                     ),
                 ]
+            if self.container == "debian:11":
+                # CX Terminal: Debian 11 LTS ended 2026-08-31 and its security
+                # updates moved to archive.debian.org; deb.debian.org still
+                # serves an index whose security packages 404.
+                steps += [
+                    RunStep(
+                        "Use archive.debian.org for EOL Debian 11 security updates",
+                        "{ grep -rl 'deb.debian.org/debian-security' /etc/apt/sources.list /etc/apt/sources.list.d 2>/dev/null || true; }"
+                        " | xargs -r sed -i 's|deb.debian.org/debian-security|archive.debian.org/debian-security|g'",
+                    ),
+                ]
             steps += [
                 RunStep("Update APT", f"{sudo}apt update"),
             ]
